```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log
apps/api/logs/errors/*.jsonl

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# SOPS / age secrets (Phase 8): never commit the age private key or any
# plaintext secret file. Only the SOPS-encrypted *.enc.yaml files are tracked.
devops/secrets/*.key
devops/secrets/*.plain.yaml
devops/secrets/*.dec.yaml
```