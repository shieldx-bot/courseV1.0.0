{
  "title": "Adaptive Learning",
  "version": 3,
  "datasource": "Prometheus",
  "description": "Adaptive Mastery Engine metrics (M1-M7 contract, Phase 5 + Phase 6). Panels show empty until the backend instruments the adaptive_* series.",
  "panels": [
    {
      "title": "Quiz Generation Throughput (by mode)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(adaptive_quiz_generated_total[5m])) by (mode)",
          "legendFormat": "{{mode}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Quiz Submissions (by mode)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(adaptive_quiz_submitted_total[5m])) by (mode)",
          "legendFormat": "{{mode}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "Quiz Pass Rate",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(adaptive_quiz_submitted_total{passed=\"true\"}[5m])) by (mode) / clamp_min(sum(rate(adaptive_quiz_submitted_total[5m])) by (mode), 1)",
          "legendFormat": "{{mode}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Submit Latency (p50 / p95 / p99)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(adaptive_quiz_submit_duration_seconds_bucket[5m])) by (le, course_id))",
          "legendFormat": "p99 {{course_id}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(adaptive_quiz_submit_duration_seconds_bucket[5m])) by (le, course_id))",
          "legendFormat": "p95 {{course_id}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(adaptive_quiz_submit_duration_seconds_bucket[5m])) by (le, course_id))",
          "legendFormat": "p50 {{course_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "title": "Mastery Decay Runs (by status)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(adaptive_mastery_decay_runs_total[1h])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Remediation Generated (by concept)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(adaptive_remediation_generated_total[1h])) by (concept_id)",
          "legendFormat": "{{concept_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "title": "Remediation Feedback Rate (helpful vs not)",
      "type": "barchart",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(adaptive_remediation_feedback_total[5m])) by (helpful)",
          "legendFormat": "{{helpful}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "title": "Remediation Exercise Submissions (top concepts)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(10, sum(increase(adaptive_remediation_exercise_submitted_total[1h])) by (concept_id))",
          "legendFormat": "{{concept_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "title": "Remediation Exercise Pass Rate (by concept)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(adaptive_remediation_exercise_submitted_total{passed=\"true\"}[5m])) by (concept_id) / clamp_min(sum(rate(adaptive_remediation_exercise_submitted_total[5m])) by (concept_id), 1)",
          "legendFormat": "{{concept_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "title": "Remediation Effectiveness (% users improved)",
      "type": "table",
      "datasource": "Adaptive Analytics API",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "ascendly-analytics-json"
          },
          "query": "remediation-effectiveness?window_days=30",
          "targetPath": "data",
          "format": "table",
          "fields": [
            {
              "name": "total_users",
              "type": "number"
            },
            {
              "name": "improved_pct",
              "type": "number"
            },
            {
              "name": "avg_mastery_delta",
              "type": "number"
            },
            {
              "name": "avg_gap_resolution_days",
              "type": "number"
            },
            {
              "name": "window_days",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "title": "Remediation Effectiveness — top weak concepts",
      "type": "table",
      "datasource": "Adaptive Analytics API",
      "targets": [
        {
          "refId": "B",
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "ascendly-analytics-json"
          },
          "query": "remediation-effectiveness?window_days=30",
          "targetPath": "data.by_concept",
          "format": "table",
          "fields": [
            {
              "name": "concept_name",
              "type": "string"
            },
            {
              "name": "weak_events",
              "type": "number"
            },
            {
              "name": "avg_mastery_delta",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "title": "Intelligence snapshot runs (by status)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(intelligence_snapshot_runs_total[1h])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "title": "Retention cleanup runs (by collection, status)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(retention_cleanup_runs_total[1h])) by (collection, status)",
          "legendFormat": "{{collection}} / {{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      }
    },
    {
      "title": "Note: waiting for data",
      "type": "text",
      "datasource": "Prometheus",
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "The adaptive_* and intelligence/retention series are exported by the backend. Panels populate as soon as AI-A instruments M1-M9 (M6/M7 = remediation feedback + exercise submit, Phase 6; M8/M9 = intelligence snapshot + retention cleanup, Phase 7). Alerts evaluate on these same series. The Remediation Effectiveness panels query the analytics endpoint (GET /api/v1/admin/adaptive/analytics/remediation-effectiveness) via the Adaptive Analytics API JSON datasource — they show real data from quiz_attempts once admin credentials are configured."
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 56
      }
    }
  ]
}
