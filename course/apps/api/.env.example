# Cloudflare Workers Environment Variables
# Set these in Cloudflare Dashboard > Workers > Settings > Variables

# Environment
ENVIRONMENT=production
FRONTEND_URL=https://ascendly.io
API_BASE_URL=https://api.ascendly.io

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Database (D1)
# MONGODB_URI and MONGODB_SECONDARY_URI are replaced by D1 binding

# Cache (KV)
# REDIS_URL is replaced by KV binding

# R2 Storage
R2_BUCKET_NAME=ascendly-videos
R2_SIGNED_URL_EXPIRY_SECONDS=3600
R2_AUTO_DELETE_DAYS=1

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_WEBHOOK_ID=xxx

# SMS
SMS_PROVIDER_API_KEY=xxx

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=xxx
SMTP_PASSWORD=xxx

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxx

# Meilisearch
MEILI_URL=https://xxx.meilisearch.io
MEILI_MASTER_KEY=xxx

# Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_ENVIRONMENT=production

# Worker Configuration
WORKER_MAX_RETRIES=5
WORKER_KEEP_RESULT_SECONDS=3600
WORKER_POLL_DELAY=0.5
WORKER_MAX_BURST_JOBS=10