# ── Ascendly — root .env template (local dev via docker compose) ──────────────
# Copy to .env and fill in real values. Everything is optional at runtime:
# empty values = graceful fallback (no LLM / no external service).
#
#   cp .env.example .env
#
# Compose passes these through to the api/worker/cron containers
# (docker-compose.yml). Backend settings are read in
# apps/api/app/core/config.py via pydantic-settings.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ── MongoDB / Redis (local compose) ──────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017/ascendly
MONGODB_SECONDARY_URI=
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# ── LLM providers ────────────────────────────────────────────────────────────
# Empty = provider disabled; the backend falls back to the next provider or
# returns a deterministic offline response. NEVER commit real keys.

# OpenAI-compatible (Groq by default, per config.py)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter (free models available)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Google Gemini (free tier via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Web search for AI content generation / RAG (optional but recommended)
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CSE_ID=
SERPAPI_API_KEY=

# ── Storage (R2) ─────────────────────────────────────────────────────────────
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ascendly-videos
R2_SIGNED_URL_EXPIRY_SECONDS=3600
R2_AUTO_DELETE_DAYS=1

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── SMS / Email ──────────────────────────────────────────────────────────────
SMS_PROVIDER_API_KEY=
# Email — dev default targets the compose Mailpit container (SMTP :1025,
# UI http://localhost:8025). Empty SMTP_USER/SMTP_PASSWORD keeps email.py's
# [DEV EMAIL] print fallback when running WITHOUT compose; inside compose the
# empty values fall back to the Mailpit dummy creds so mail lands in the UI.
# For real SMTP set SMTP_HOST/PORT/USER/PASSWORD (user+pass must be non-empty).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@ascendly.io

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Meilisearch (compose) ────────────────────────────────────────────────────
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=ascendly-dev-master-key

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TELEMETRY_ENABLED=true
TELEMETRY_ENVIRONMENT=development

# ── Error logging ────────────────────────────────────────────────────────────
ERROR_LOG_DIR=logs/errors
ERROR_LOG_MAX_FILE_SIZE_MB=100
ERROR_LOG_RETENTION_DAYS=30
ERROR_LOG_TO_MONGODB=true

# ── Cloud native runtime ─────────────────────────────────────────────────────
WORKER_MAX_RETRIES=5
WORKER_KEEP_RESULT_SECONDS=3600
WORKER_POLL_DELAY=0.5
WORKER_MAX_BURST_JOBS=10
APP_TIMEZONE=UTC
